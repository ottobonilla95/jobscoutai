# Generated from config/product.json and config/templates; run npm run brand:sync.
[Unit]
Description=Back up JobScout AI PostgreSQL using pg_dump
After=network-online.target

[Service]
Type=oneshot
User=jobscout
Group=jobscout
WorkingDirectory=/opt/job-searcher
ExecStart=/opt/job-searcher/runtime/bin/node --env-file=.env --import tsx scripts/backup.ts
TimeoutStartSec=5min
UMask=0077
