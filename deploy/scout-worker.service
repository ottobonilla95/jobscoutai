# Generated from config/product.json and config/templates; run npm run brand:sync.
[Unit]
Description=Check and run due JobScout AI searches
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jobscout
Group=jobscout
WorkingDirectory=/opt/job-searcher
Environment=NODE_ENV=production
ExecStart=/opt/job-searcher/runtime/bin/node --env-file=.env --import tsx apps/worker/src/index.ts
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
