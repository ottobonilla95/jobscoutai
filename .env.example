# Run npm run setup to create .env. Users create their own accounts at /signup.
APP_URL=http://localhost:3000
ALLOW_SIGNUP=true
# Shared PostgreSQL connection (Neon pooled URL). Keep server-side only.
DATABASE_URL=
# Optional direct connection for pg_dump.
DATABASE_URL_UNPOOLED=
# Local backup output only; the application stores data in PostgreSQL.
DATA_DIR=
# Direct OpenAI API key, shared by the server and worker. Keep server-side only.
OPENAI_API_KEY=
# Optional alternative when OPENAI_API_KEY is not set.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
AI_REASONING_EFFORT=medium
RESEND_API_KEY=
EMAIL_FROM=
# Production domain for Caddy, e.g. jobs.example.com
APP_DOMAIN=localhost
# Global daily AI generation cap across all accounts (UTC). Also set provider spending limits.
AI_DAILY_CALL_LIMIT=500

# Minimum hours between searches (2–168). Invalid values fall back to 4.
MIN_SEARCH_INTERVAL_HOURS=4
